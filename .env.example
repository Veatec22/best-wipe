# Copy this file to `.env` and adjust as needed. All values are optional.

# App mode: "player" (default) or "admin" (extra debug/inspection panes).
MODE=player

# Skip the in-browser AI entirely (1 = disabled). Useful on machines without
# WebGPU, or for faster startup. When unset, the local LLM is enabled.
VITE_SKIP_AI=1

# WebLLM model loaded for the in-game "Ask AI" feature (runs locally via WebGPU).
VITE_WEBLLM_MODEL_ID=Llama-3.2-1B-Instruct-q4f16_1-MLC

# Max number of "Ask AI" requests granted per in-game day (optional).
# VITE_AI_DAILY_LIMIT=3

# Pixelation block size applied to uploaded player avatars (optional).
VITE_PLAYER_AVATAR_BLOCK_SIZE=2
